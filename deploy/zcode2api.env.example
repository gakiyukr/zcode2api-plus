# zcode2api-plus 裸機部署環境設定（systemd EnvironmentFile 格式）
#
# install.sh 會將此檔複製為 deploy/zcode2api.env 並替換實際路徑；
# 修改後執行 systemctl restart zcode2api 生效。完整變數清單見 README「环境变量」。

# ── 服務 ─────────────────────────────────────────────────────
# 對外監聽位址：0.0.0.0=對外開放；置於 Nginx 等反向代理之後時建議改 127.0.0.1
ZCODE_HOST=0.0.0.0
ZCODE_PORT=3000
# 後台密碼初始值（僅在資料庫缺失或仍為歷史預設值時生效，之後以資料庫為準）；
# 不設定時首次啟動隨機生成並列印於啟動日誌。請勿沿用舊預設值 zcode。
#ZCODE_ADMIN_KEY=改成你的後台密碼
# 網關 API Key 初始值（一律必填，未設定時隨機生成，列印於啟動日誌）
#ZCODE_GATEWAY_KEY=改成你的網關金鑰

# ── 路徑（install.sh 會依專案位置改寫）────────────────────────
ZCODE_DATA_DIR=/opt/zcode2api/data
ZCODE_NODE_PATH=/usr/bin/node

# ── 驗證碼求解 ───────────────────────────────────────────────
# false：僅用 Node + jsdom 求解器，免 Chromium（預設推薦，功能完整）
# true ：啟用真實 Chromium 池，需以 --with-browser 安裝系統庫與瀏覽器二進制；
#        池啟動失敗時會自動回退 Node 求解器（60 秒冷卻）
ZCODE_CAPTCHA_BROWSER=false
CLOAKBROWSER_CACHE_DIR=/opt/zcode2api/data/cloakbrowser-cache
CLOAKBROWSER_AUTO_UPDATE=false
CLOAKBROWSER_SUPPRESS_FONT_WARNING=1

# ── 維運 ─────────────────────────────────────────────────────
# 後台自動輪詢帳號額度的間隔（秒），0=關閉僅按需刷新
ZCODE_QUOTA_REFRESH_INTERVAL=600
