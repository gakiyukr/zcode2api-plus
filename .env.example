# 本文件仅为配置参考：程序不会自动加载 .env，请自行 source 或写入 systemd Environment。
# 全部变量定义见 internal/config/config.go。

# ── 服务 ──────────────────────────────────────────
ZCODE_PORT=3000
ZCODE_HOST=0.0.0.0

# ── 鉴权 ──────────────────────────────────────────
# 后台密码初始值（仅在数据库缺失或仍为历史默认值时生效，之后以数据库为准）；
# 不设置时首次启动随机生成并打印于启动日志。请勿沿用旧默认值 zcode。
#ZCODE_ADMIN_KEY=改成你的后台密码
# 网关 API Key 初始值（一律必填，未设置时随机生成，打印于启动日志）
#ZCODE_GATEWAY_KEY=改成你的网关金钥

# ── 数据目录（账号保存在本目录下的 SQLite）────────
ZCODE_DATA_DIR=./data

# ── 用量监控 ──────────────────────────────────────
# 后台自动刷新各账号额度的间隔（秒），0 关闭
ZCODE_QUOTA_REFRESH_INTERVAL=60
# 限流冷却时长（秒）
ZCODE_COOLING_SECONDS=300

# ── 验证码：真实浏览器自动求解 ────────────────────
# 启用 rod 浏览器池（首次启动自动下载补丁 Chromium，约 200MB）；关闭时回退人工回填
ZCODE_CAPTCHA_BROWSER=false
# 指定已有浏览器二进制；留空则按
# ZCODE_CAPTCHA_BROWSER_BIN → CLOAKBROWSER_BINARY_PATH → CLOAKBROWSER_CACHE_DIR → 自动下载 依次发现
#ZCODE_CAPTCHA_BROWSER_BIN=/path/to/chrome
# 浏览器池并发槽位、启动/单次求解/排队/关闭超时（秒）、失败冷却（秒）
#ZCODE_CAPTCHA_BROWSER_WORKERS=1
#ZCODE_CAPTCHA_BROWSER_STARTUP_TIMEOUT=90
#ZCODE_CAPTCHA_BROWSER_REQUEST_TIMEOUT=45
#ZCODE_CAPTCHA_BROWSER_QUEUE_TIMEOUT=60
#ZCODE_CAPTCHA_BROWSER_SHUTDOWN_TIMEOUT=10
#ZCODE_CAPTCHA_BROWSER_FAILURE_COOLDOWN=60
# 单次求解超时（秒）
#ZCODE_CAPTCHA_TIMEOUT=40

# ── 验证码缓存（毫秒）─────────────────────────────
# 上游验证码配置缓存；人工回填令牌缓存
#CAPTCHA_CONFIG_CACHE_TTL=600000
#CAPTCHA_MANUAL_CACHE_TTL=45000

# ── Async 空闲池 ──────────────────────────────────
#ZCODE_ASYNC_ENABLED=true
#ZCODE_ASYNC_TICKET_TIMEOUT=300
#ZCODE_ASYNC_MAX_RETRIES=3

# ── 上游端点（一般无需修改）───────────────────────
# ZAI_UPSTREAM_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
# ZAI_FALLBACK_URL=https://api.z.ai/api/anthropic/v1/messages
# ZCODE_CLIENT_VERSION=3.7.7
# ZCODE_CLIENT_PLATFORM=win32-x64
# UPSTREAM_USER_AGENT=ZCode/3.7.7

# ── 浏览器二进制下载（cloakbrowser，一般无需修改）──
# 缓存目录（默认 ~/.cloakbrowser）；下载源覆盖（默认 cloakbrowser.dev，回退 GitHub Releases）
#CLOAKBROWSER_CACHE_DIR=
#CLOAKBROWSER_DOWNLOAD_URL=
